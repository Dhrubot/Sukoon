{
  "expo": {
    "name": "PrayerBuddy",
    "slug": "prayer-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E3F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talukders.prayerbuddy",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PrayerBuddy needs your location to calculate accurate prayer times for your area.",
        "NSUserNotificationsUsageDescription": "PrayerBuddy needs notification permission to remind you of prayer times."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E3F"
      },
      "package": "com.talukders.prayerbuddy",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-location",
      "react-native-mmkv"
    ],
    "extra": {
      "eas": {
        "projectId": "talukders-prayerbuddy-id"
      }
    }
  }
}