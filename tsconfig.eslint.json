{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    ".eslintrc.js",
    "app.config.js",
    "App.tsx",
    "edge-api/src/**/*",
    "index.ts",
    "jest.afterEnv.js",
    "jest.config.js",
    "jest.setup.js",
    "metro.config.js",
    "plugins/**/*",
    "src/**/*"
  ],
  "exclude": [
    "android",
    "coverage",
    "dist",
    "edge-api",
    "ios",
    "node_modules"
  ]
}
